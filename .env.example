# Mẫu biến môi trường. Copy thành .env (file .env không được commit) rồi sửa giá trị.
# Docker compose đọc file .env tự động. Chạy tay (Eclipse) thì đặt các biến này trong Run Configurations > Environment.

# ---- ZTNA Server ----
# MySQL. XAMPP mặc định: DB_USERNAME=root và DB_PASSWORD để trống.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ztna_db
DB_USERNAME=root
DB_PASSWORD=doi-mat-khau-nay
# Khoá ký JWT, tối thiểu 32 ký tự. Không đặt thì server tự sinh ngẫu nhiên mỗi lần khởi động.
JWT_SECRET=thay-bang-chuoi-ngau-nhien-it-nhat-32-ky-tu

# ---- Agent (máy người dùng) ----
# SERVER_URL=ws://<IP-may-Server>:9443/app

# ---- Connector (máy trong mạng nội bộ) ----
# SERVER_URL=ws://<IP-may-Server>:8443/connector
# CONNECTOR_TOKEN=<Connection String của connector, lấy ở trang Connectors>
